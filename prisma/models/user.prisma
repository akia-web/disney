model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     Role     @default(USER)
  resetPasswordCode      String?  @unique
  expiresResetPasswordCodeAt DateTime?

  sessions Session[]
  characterUsers CharacterUser[]
  dreamsnaps Dreamsnap[]
}

enum Role {
  ADMIN
  USER
}